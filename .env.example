# --- Zendesk connection (required) ---
ZENDESK_SUBDOMAIN=xxx
ZENDESK_API_KEY=xxx
# Single-identity mode:
ZENDESK_EMAIL=agent@example.com
# OR dual-identity mode (Layer 4 backstop — read via restricted user, write via full agent).
# When set, these override ZENDESK_EMAIL:
#ZENDESK_READ_EMAIL=mcp-reader@example.com
#ZENDESK_WRITE_EMAIL=mcp-writer@example.com

# --- Transport ---
# stdio (local Claude Desktop) | http (remote Streamable HTTP on /mcp)
MCP_TRANSPORT=stdio
#MCP_HOST=0.0.0.0
#MCP_PORT=8000

# --- Auth (HTTP transport only) ---
# keys  = internal API keys (Bearer zmk_...; manage with zendesk-keys or admin console)
# oauth = OAuth 2.1 resource server (generic OIDC: Auth0/Descope/Cognito/Keycloak/...)
# both  = accept either
#MCP_AUTH_MODE=keys
#MCP_AUTH_ENABLED=true
#MCP_KEYS_DB=data/keys.db

# --- OAuth 2.1 (MCP_AUTH_MODE=oauth|both) ---
#MCP_PUBLIC_URL=https://mcp.example.com
#MCP_OAUTH_ISSUER=https://your-tenant.auth0.com/
#MCP_OAUTH_AUDIENCE=https://mcp.example.com
#MCP_OAUTH_JWKS_URI=            # default: <issuer>/.well-known/jwks.json
#MCP_OAUTH_AUTH_SERVERS=        # default: issuer
# JWT claim that names the caller's tenant (multi-tenancy); value = tenant id or name
#MCP_OAUTH_TENANT_CLAIM=zendesk_tenant

# --- Admin console (HTTP mode; enabled only when a password is set) ---
# Runs on a separate port (default 127.0.0.1:9000) — NEVER expose publicly.
# Access via SSH tunnel: ssh -L 9000:localhost:9000 user@host
#MCP_ADMIN_PASSWORD=change-me-to-something-long
#MCP_ADMIN_HOST=127.0.0.1
#MCP_ADMIN_PORT=9000

# --- Layer 3: elicit user approval before posting PUBLIC comments ---
# Requires an MCP client that supports elicitation.
#MCP_WRITE_CONFIRMATION=true

# --- Docker compose (TLS) ---
# Public DNS name for Caddy's automatic HTTPS
#MCP_DOMAIN=mcp.example.com
